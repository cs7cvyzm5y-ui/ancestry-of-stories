{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Ancestry of Stories graph package",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "properties": {
    "meta": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "description", "tags", "personal_seed", "metrics"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "type": {"enum": ["work", "person", "tradition", "context", "medium"]},
          "year": {"type": ["integer", "null"]},
          "culture": {"type": "string"},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "personal_seed": {"type": "boolean"},
          "metrics": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "confidence", "evidence", "note", "status"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"type": "string"},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "evidence": {"type": "string"},
          "note": {"type": "string"},
          "source_url": {"type": "string"},
          "source_label": {"type": "string"},
          "status": {"enum": ["verified", "review"]}
        }
      }
    }
  }
}
